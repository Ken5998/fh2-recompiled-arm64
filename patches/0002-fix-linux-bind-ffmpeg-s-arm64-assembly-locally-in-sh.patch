From: =?UTF-8?q?Kenan=20Kasumovi=C4=87?=
 <46025606+Ken5998@users.noreply.github.com>
Date: Tue, 10 Nov 2026 08:46:57 +0000
Subject: [PATCH 2/5] fix(linux): bind ffmpeg's arm64 assembly locally in
 shared objects

---
 sdk/thirdparty/CMakeLists.txt | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/sdk/thirdparty/CMakeLists.txt b/sdk/thirdparty/CMakeLists.txt
index 4bc4295..309ff98 100644
--- a/sdk/thirdparty/CMakeLists.txt
+++ b/sdk/thirdparty/CMakeLists.txt
@@ -802,6 +802,14 @@ set_target_properties(libavutil libavcodec PROPERTIES
     C_VISIBILITY_PRESET hidden
     VISIBILITY_INLINES_HIDDEN ON
     FOLDER "FFmpeg")
+# The visibility preset does not reach the .S files, so their exported
+# functions stay preemptible in a shared object and a conditional branch to
+# one (ff_prefetch_aarch64 branches to itself) goes through a far PLT entry
+# that lld cannot reach ("R_AARCH64_CONDBR19 out of range" on Linux). Hiding
+# every symbol of the two archives in whatever links them binds them locally.
+if(IS_ARM64 AND UNIX AND NOT APPLE)
+    target_link_options(libavcodec INTERFACE "LINKER:--exclude-libs,liblibavcodec.a:liblibavutil.a")
+endif()
 
